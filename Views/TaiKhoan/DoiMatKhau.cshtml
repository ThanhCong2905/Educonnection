@model KetNoiGiaSu.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="auth-card"><h1>Đổi mật khẩu</h1><p class="subtitle">Sau khi đổi, bạn cần đăng nhập lại trên các thiết bị.</p>
    <form asp-action="DoiMatKhau" method="post" data-auth-form>
        <div asp-validation-summary="All" class="notice error" role="alert"></div>
        <div class="field"><label asp-for="CurrentPassword">Mật khẩu hiện tại <span class="required">*</span></label><div class="input-wrap"><input asp-for="CurrentPassword" autocomplete="current-password" required maxlength="64" /><button class="reveal" type="button" data-password="CurrentPassword" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false"><img src="~/images/auth/eye.png" alt="" width="20" height="20" /></button></div></div>
        <partial name="_NewPasswordFields" />
        <button class="primary-button" type="submit" data-idle="Đổi mật khẩu" data-busy="Đang cập nhật…">Đổi mật khẩu</button>
        <p class="switch-form"><a asp-action="TongQuan">Quay lại tài khoản</a></p>
    </form>
</section>
