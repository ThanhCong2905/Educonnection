@model KetNoiGiaSu.Models.ApplicationUser
@{ ViewData["Title"] = "Tài khoản của tôi"; var role = User.IsInRole("GiaSu") ? "Gia sư" : User.IsInRole("PhuHuynh") ? "Phụ huynh" : User.IsInRole("HocSinh") ? "Học sinh" : User.IsInRole("Admin") || User.IsInRole("QuanTriVien") ? "Quản trị viên" : "Chưa được phân vai"; }
<section class="auth-card message-card"><span class="eyebrow">@role</span><h1>Xin chào, @Model.HoTen</h1><p>Bạn đã đăng nhập thành công vào EduConnect.</p><dl class="account-details"><dt>Email</dt><dd>@Model.Email</dd><dt>Số điện thoại</dt><dd>@Model.PhoneNumber</dd><dt>Vai trò</dt><dd>@role</dd></dl><a class="primary-button" asp-action="DoiMatKhau">Đổi mật khẩu</a><form asp-action="DangXuat" method="post"><button type="submit" class="secondary-button">Đăng xuất</button></form></section>
