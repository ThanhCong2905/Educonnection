<div class="field"><label for="Password">Mật khẩu mới <span class="required">*</span></label><div class="input-wrap"><input id="Password" name="Password" type="password" autocomplete="new-password" required minlength="15" maxlength="64" aria-describedby="password-help" /><button class="reveal" type="button" data-password="Password" aria-label="Hiện mật khẩu mới" aria-pressed="false"><img src="~/images/auth/eye.png" alt="" width="20" height="20" /></button></div><p class="field-help" id="password-help">15–64 ký tự, cho phép khoảng trắng; không dùng mật khẩu phổ biến.</p></div>
<div class="field"><label for="ConfirmPassword">Xác nhận mật khẩu mới <span class="required">*</span></label><div class="input-wrap"><input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required minlength="15" maxlength="64" data-confirm="Password" /><button class="reveal" type="button" data-password="ConfirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><img src="~/images/auth/eye.png" alt="" width="20" height="20" /></button></div></div>
