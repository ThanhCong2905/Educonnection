@model KetNoiGiaSu.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký tài khoản"; ViewData["MainClass"] = "auth-main register-main"; }
<section class="auth-card register-card" aria-labelledby="page-title">
    <h1 id="page-title">Đăng ký tài khoản</h1>
    <p class="subtitle">Tham gia mạng lưới kết nối gia sư và học sinh EduConnect</p>
    <form asp-action="DangKy" method="post" data-auth-form>
        <div asp-validation-summary="ModelOnly" class="notice error" role="alert"></div>
        <fieldset class="role-field"><legend>Bạn là ai? <span class="required">*</span></legend>
            <div class="role-options">
            @foreach (var role in new[] { ("HocSinh", "Học sinh"), ("PhuHuynh", "Phụ huynh"), ("GiaSu", "Gia sư") })
            {
                <label><input asp-for="Role" type="radio" value="@role.Item1" /><span>@role.Item2</span></label>
            }
            </div>
            <span asp-validation-for="Role" class="field-error"></span>
        </fieldset>
        <div class="field"><label asp-for="FullName">Họ và tên <span class="required">*</span></label><input asp-for="FullName" placeholder="Nguyễn Văn A" autocomplete="name" required minlength="2" maxlength="150" /><span asp-validation-for="FullName" class="field-error"></span></div>
        <div class="field"><label asp-for="Email">Email <span class="required">*</span></label><input asp-for="Email" type="email" placeholder="nguyen.van.a@example.com" autocomplete="email" required maxlength="256" /><span asp-validation-for="Email" class="field-error"></span></div>
        <div class="field"><label asp-for="Phone">Số điện thoại <span class="required">*</span></label><input asp-for="Phone" type="tel" placeholder="0912 345 678" autocomplete="tel" required maxlength="18" /><span asp-validation-for="Phone" class="field-error"></span></div>
        <div class="password-grid">
            <div class="field"><label asp-for="Password">Mật khẩu <span class="required">*</span></label><div class="input-wrap"><input asp-for="Password" autocomplete="new-password" placeholder="••••••••" minlength="15" maxlength="64" required aria-describedby="password-help" /><button class="reveal" type="button" data-password="Password" aria-label="Hiện mật khẩu" aria-pressed="false"><img src="~/images/auth/eye.png" alt="" width="20" height="20" /></button></div><span asp-validation-for="Password" class="field-error"></span></div>
            <div class="field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu <span class="required">*</span></label><div class="input-wrap"><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="••••••••" minlength="15" maxlength="64" required data-confirm="Password" /><button class="reveal" type="button" data-password="ConfirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><img src="~/images/auth/eye.png" alt="" width="20" height="20" /></button></div><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
        </div>
        <p class="field-help" id="password-help">Từ 15–64 ký tự, cho phép khoảng trắng; tránh mật khẩu phổ biến.</p>
        <label class="checkbox terms"><input asp-for="AcceptTerms" required /><span>Tôi đồng ý với <a asp-controller="Home" asp-action="Information" asp-route-section="terms" target="_blank" rel="noopener">Điều khoản sử dụng</a> và <a asp-controller="Home" asp-action="Information" asp-route-section="privacy" target="_blank" rel="noopener">Chính sách bảo mật</a></span></label>
        <span asp-validation-for="AcceptTerms" class="field-error"></span>
        <button class="primary-button" type="submit" data-idle="Tạo tài khoản" data-busy="Đang tạo tài khoản…">Tạo tài khoản</button>
        <p class="switch-form">Đã có tài khoản? <a asp-action="DangNhap">Đăng nhập</a></p>
    </form>
</section>
