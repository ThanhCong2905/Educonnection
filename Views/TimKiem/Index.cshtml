@model KetNoiGiaSu.ViewModels.WorkspaceViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="breadcrumbs"><a asp-controller="Workspace" asp-action="Index">Trang chủ</a><span>/</span>@Model.Title</div>
<div class="page-heading"><div><p class="overline">TÌM KIẾM & LỰA CHỌN</p><h1>@(Model.IsTutor ? "Tìm học sinh cần bạn đồng hành" : "Tìm gia sư cho hành trình của bạn")</h1><p>@(Model.IsTutor ? "Khám phá các nhu cầu học đang mở của học sinh và phụ huynh." : "Khám phá nhu cầu nhận lớp từ những gia sư đã được duyệt hồ sơ.")</p></div></div>
<form asp-controller="TimKiem" asp-action="Tim" method="get" class="filter-panel surface">
    <div asp-validation-summary="All" class="alert alert-warning" role="alert"></div>
    <div class="search-line"><img src="~/images/ui/search.svg" width="20" height="20" alt="" /><label class="visually-hidden" for="Q">Từ khóa</label><input class="form-control" id="Q" name="Q" value="@Model.Search.Q" maxlength="150" placeholder="@(Model.IsTutor ? "Tìm theo môn học, mục tiêu…" : "Tìm theo tên gia sư, môn học…")" /><button class="btn btn-pink" type="submit">Tìm kiếm</button></div>
    <div class="row g-3 mt-0">
        <div class="col-6 col-lg"><label class="form-label" for="SubjectId">Môn học</label><select class="form-select" id="SubjectId" name="SubjectId"><option value="">Tất cả môn</option>@foreach (var s in Model.Subjects) { <option value="@s.Id" selected="@(Model.Search.SubjectId == s.Id)">@s.TenMon</option> }</select></div>
        <div class="col-6 col-lg"><label class="form-label" for="Grade">Khối lớp</label><select class="form-select" id="Grade" name="Grade"><option value="">Tất cả khối</option>@for (var grade=1;grade<=12;grade++) { var text="Lớp "+grade; <option selected="@(Model.Search.Grade == text)">@text</option> }</select></div>
        <div class="col-6 col-lg"><label class="form-label" for="Region">Khu vực</label><input class="form-control" name="Region" id="Region" value="@Model.Search.Region" maxlength="200" placeholder="Tỉnh, thành phố…" /></div>
        <div class="col-6 col-lg"><label class="form-label" for="Format">Hình thức</label><select class="form-select" id="Format" name="Format"><option value="">Tất cả hình thức</option><option value="0" selected="@(Model.Search.Format == 0)">Trực tuyến</option><option value="1" selected="@(Model.Search.Format == 1)">Trực tiếp</option></select></div>
        <div class="col-6 col-lg"><label class="form-label" for="MaxFee">Học phí tối đa (đ)</label><input class="form-control" name="MaxFee" id="MaxFee" value="@Model.Search.MaxFee" type="number" min="0" max="100000000" step="1000" placeholder="Không giới hạn" /></div>
        <div class="col-6 col-lg"><label class="form-label" for="FeeUnit">Đơn vị học phí</label><select class="form-select" id="FeeUnit" name="FeeUnit"><option value="">Tất cả đơn vị</option><option value="1" selected="@(Model.Search.FeeUnit == 1)">Theo buổi</option><option value="0" selected="@(Model.Search.FeeUnit == 0)">Theo giờ</option><option value="2" selected="@(Model.Search.FeeUnit == 2)">Theo tháng</option></select></div>
    </div><div class="filter-footer"><span>So sánh tối đa 3 nhu cầu theo cùng các tiêu chí.</span><a asp-controller="TimKiem" asp-action="Tim">Xóa bộ lọc</a></div>
</form>
<div class="section-heading results-heading"><h2>@Model.Total @(Model.IsTutor ? "nhu cầu học" : "nhu cầu nhận lớp") đang mở</h2><span class="text-muted small">Mới đăng gần đây</span></div>
@if (Model.Cards.Count == 0)
{ <div class="empty-state surface"><span class="empty-icon"><img src="~/images/ui/search.svg" width="32" height="32" alt="" /></span><h2>Chưa tìm thấy kết quả</h2><p>Thử đổi từ khóa, chọn môn khác hoặc mở rộng điều kiện tìm kiếm.</p><a class="btn btn-outline-pink" asp-controller="TimKiem" asp-action="Tim">Xem tất cả nhu cầu</a></div> }
else
{ <div class="row g-4">@foreach (var card in Model.Cards) { <div class="col-md-6 col-xl-4"><partial name="_NeedCard" model="card" /></div> }</div>
<nav class="pagination-nav" aria-label="Phân trang kết quả">@for(var page=1;page<=Model.PageCount;page++) { if(page != 1 && page != Model.PageCount && Math.Abs(page-Model.Search.Page)>2) { continue; } <a class="page-link @(page == Model.Search.Page ? "active" : "")" aria-current="@(page == Model.Search.Page ? "page" : null)" asp-controller="TimKiem" asp-action="Tim" asp-route-page="@(page)" asp-route-Q="@Model.Search.Q" asp-route-SubjectId="@Model.Search.SubjectId" asp-route-Grade="@Model.Search.Grade" asp-route-Region="@Model.Search.Region" asp-route-Format="@Model.Search.Format" asp-route-MaxFee="@Model.Search.MaxFee" asp-route-FeeUnit="@Model.Search.FeeUnit">@(page)</a> }</nav> }
