@model KetNoiGiaSu.ViewModels.ProfileDetailViewModel
@using KetNoiGiaSu.Models
@using KetNoiGiaSu.ViewModels
@{ var profile=Model.Profile;var own=Model.Workspace.IsTutor&&Model.Workspace.UserId==profile.GiaSuId;var c=Model.Conditions;ViewData["Title"]="Hồ sơ "+Model.Name; }
<div class="breadcrumbs"><a asp-controller="TimKiem" asp-action="Tim">Tìm kiếm gia sư</a><span>/</span>Hồ sơ gia sư</div>
@if(own&&Model.LatestRevision!=null){<div class="alert @(Model.LatestRevision.TrangThai==ProfileReviewState.Rejected?"alert-warning":"alert-info")">@if(Model.LatestRevision.TrangThai==ProfileReviewState.Pending){<span>Bản chuyên môn mới đang chờ duyệt. Bản đã được duyệt trước đó vẫn có hiệu lực.</span>}else if(Model.LatestRevision.TrangThai==ProfileReviewState.Rejected){<span>Bản sửa bị từ chối: @Model.LatestRevision.LyDoTuChoi</span>}else{<span>Hồ sơ chuyên môn đã được duyệt.</span>}</div>}
<div class="row g-4"><div class="col-xl-8"><section class="surface profile-section">
<div class="d-flex align-items-center gap-3 mb-4">@if(!string.IsNullOrEmpty(profile.AnhDaiDien)){<img src="@profile.AnhDaiDien" class="tutor-avatar" width="88" height="88" alt="Ảnh đại diện @Model.Name" />}<div><h1>@Model.Name</h1><span class="tag @(profile.TrangThaiDuyet==ProfileReviewState.Approved?"approved":"")">@(profile.TrangThaiDuyet==ProfileReviewState.Approved?"Hồ sơ đã duyệt":"Hồ sơ chưa được duyệt")</span></div></div>
<h2>Giới thiệu</h2><p class="preserve-lines">@profile.MoTa</p>
<h2 class="mt-4">Trình độ và chuyên môn</h2><dl><dt>Trình độ</dt><dd>@profile.TrinhDo</dd><dt>Trường đào tạo</dt><dd>@profile.TruongDaoTao</dd><dt>Chuyên ngành</dt><dd>@profile.ChuyenNganh</dd><dt>Tình trạng học tập</dt><dd>@(profile.TinhTrangHocTap=="DaTotNghiep"?"Đã tốt nghiệp":"Đang học")</dd></dl>
<h3 class="fs-5">Môn và phạm vi dạy</h3><div class="d-flex flex-wrap gap-2">@foreach(var subject in Model.Subjects){<span class="tag">@subject</span>}</div>
<h3 class="fs-5 mt-4">Thế mạnh chuyên môn</h3><p class="preserve-lines">@profile.ChuyenMon</p>
<h3 class="fs-5 mt-4">Kinh nghiệm</h3><p class="preserve-lines">@profile.KinhNghiem</p><p class="private-note">Giấy tờ minh chứng, email, số điện thoại và địa chỉ chi tiết không được công khai.</p>
</section><section class="surface profile-section mt-4"><h2>Điều kiện nhận lớp</h2>
@if(c==null){<p>Chưa cập nhật điều kiện nhận lớp.</p>}else{
<span class="tag @(c.DangNhanHocVien?"approved":"")">@(c.DangNhanHocVien?"Đang nhận học viên":"Tạm ngừng nhận học viên mới")</span>
<p class="mt-3">@(c.DayTrucTuyen?"Trực tuyến":"") @(c.DayTrucTuyen&&c.DayTrucTiep?" · ":"") @(c.DayTrucTiep?"Trực tiếp · "+c.KhuVuc:"")</p>
<p class="profile-price">@(c.HocPhi.HasValue?c.HocPhi.Value.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))+"đ":"Thỏa thuận") @if(c.HocPhi.HasValue){<small>/ @(c.DonViHocPhi==0?"giờ":c.DonViHocPhi==1?"buổi":"tháng")</small>}</p>
<h3 class="fs-5">Lịch rảnh (giờ Việt Nam)</h3><div class="d-flex flex-wrap gap-2">@foreach(var slot in Model.Availability){<span class="tag">@(slot.ThuTrongTuan==0?"Chủ nhật":"Thứ "+(slot.ThuTrongTuan+1)) · @slot.GioBatDau.ToString("HH:mm")–@slot.GioKetThuc.ToString("HH:mm")</span>}</div>
}
</section></div><aside class="col-xl-4"><section class="surface contact-panel">
@if(own){<h2>Quản lý hồ sơ gia sư</h2><p>Chuyên môn được duyệt riêng. Điều kiện nhận lớp có thể cập nhật bất cứ lúc nào.</p><a class="btn btn-pink w-100 mt-2" asp-action="Sua">Sửa hồ sơ chuyên môn</a><a class="btn btn-outline-pink w-100 mt-2" asp-action="DieuKien">Sửa điều kiện nhận lớp</a><a class="btn btn-link w-100 mt-2" asp-controller="Workspace" asp-action="Status">Theo dõi xét duyệt</a>}
else if(!Model.Workspace.IsTutor){<h2>Liên hệ cùng gia sư</h2><p>Gửi lời nhắn giới thiệu để gia sư chấp nhận liên hệ trước khi trao đổi.</p><partial name="_ContactPanel" model="@(new ContactPanelViewModel {Owner=Model.Workspace.UserId,Target=profile.GiaSuId,Contact=Model.Contact})" />}
else{<p>Kết nối dành cho gia sư với học sinh hoặc phụ huynh.</p>}
</section></aside></div>
@if(own){<div class="mt-4">@await Component.InvokeAsync("ProfileExtras")</div>}
