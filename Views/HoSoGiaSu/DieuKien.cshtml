@model KetNoiGiaSu.ViewModels.TutorConditionsEditor
@{ ViewData["Title"]="Điều kiện nhận lớp"; }
<div class="page-heading"><div><p class="overline">CHỦ ĐỘNG SẮP XẾP VIỆC DẠY</p><h1>Điều kiện nhận lớp</h1><p>Cập nhật có hiệu lực ngay, không làm thay đổi trạng thái duyệt hồ sơ chuyên môn.</p></div></div>
<form asp-controller="HoSoGiaSu" asp-action="DieuKien" method="post" class="surface editor-section" data-workspace-form>
<input asp-for="Form.Version" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div>
<fieldset class="mb-4"><legend class="fs-5">Hình thức và khu vực</legend><div class="d-flex flex-wrap gap-4 mb-3"><label><input asp-for="Form.Online" class="form-check-input" /> Trực tuyến</label><label><input asp-for="Form.InPerson" class="form-check-input" /> Trực tiếp</label></div><label asp-for="Form.Region" class="form-label">Khu vực dạy trực tiếp</label><input asp-for="Form.Region" class="form-control" maxlength="200" placeholder="Quận, huyện và tỉnh/thành phố; không nhập số nhà" /></fieldset>
<fieldset class="mb-4"><legend class="fs-5">Học phí tham khảo</legend><div class="row g-3"><div class="col-md-6"><label asp-for="Form.Fee" class="form-label">Mức học phí (VND)</label><input asp-for="Form.Fee" type="number" min="0" max="100000000" class="form-control" /><p class="form-text">Để trống nếu muốn thỏa thuận.</p></div><div class="col-md-6"><label asp-for="Form.FeeUnit" class="form-label">Đơn vị</label><select asp-for="Form.FeeUnit" class="form-select"><option value="0">Mỗi giờ</option><option value="1">Mỗi buổi</option><option value="2">Mỗi tháng</option></select></div></div></fieldset>
<fieldset class="mb-4"><legend class="fs-5">Lịch rảnh hằng tuần</legend><p class="text-muted">Bật ngày có thể dạy và điều chỉnh giờ. Giờ được hiểu theo giờ Việt Nam.</p>
@for(var i=0;i<Model.Form.Slots.Count;i++) {<div class="row g-2 align-items-center mb-3"><div class="col-12 col-md-4"><input asp-for="Form.Slots[i].Day" type="hidden" /><label><input asp-for="Form.Slots[i].Enabled" class="form-check-input" /> @(Model.Form.Slots[i].Day==0?"Chủ nhật":"Thứ "+(Model.Form.Slots[i].Day+1))</label></div><div class="col-6 col-md-4"><label asp-for="Form.Slots[i].Start" class="form-label small">Từ</label><input asp-for="Form.Slots[i].Start" type="time" class="form-control" /></div><div class="col-6 col-md-4"><label asp-for="Form.Slots[i].End" class="form-label small">Đến</label><input asp-for="Form.Slots[i].End" type="time" class="form-control" /></div></div>}
</fieldset><label class="form-check mb-4"><input asp-for="Form.AcceptingStudents" class="form-check-input" /> Đang nhận học viên mới</label>
<button class="btn btn-pink" type="submit">Lưu điều kiện nhận lớp</button><a class="btn btn-light ms-2" asp-controller="HoSoGiaSu" asp-action="ChiTiet">Quay lại hồ sơ</a></form>
