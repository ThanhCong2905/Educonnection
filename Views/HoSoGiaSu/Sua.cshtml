@model KetNoiGiaSu.ViewModels.ProfileEditorViewModel
@{ ViewData["Title"]="Hồ sơ chuyên môn gia sư"; }
<div class="page-heading"><div><p class="overline">THÔNG TIN ĐƯỢC XÉT DUYỆT</p><h1>Hồ sơ chuyên môn gia sư</h1><p>Chỉ sửa mục cần thay đổi. Bản đã duyệt tiếp tục hiển thị trong khi bản sửa chờ xét duyệt.</p></div><a class="btn btn-outline-pink" asp-action="DieuKien">Điều kiện nhận lớp</a></div>
@if(Model.HasPendingRevision){<div class="alert alert-info">Bạn đang chỉnh bản chờ duyệt. Lưu lại sẽ cập nhật bản chờ duyệt này.</div>}
<form asp-controller="HoSoGiaSu" asp-action="Luu" method="post" enctype="multipart/form-data" data-workspace-form>
<input asp-for="Form.Version" type="hidden" /><input asp-for="Form.RevisionVersion" type="hidden" />
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="row g-4"><div class="col-lg-8"><section class="surface editor-section"><h2>Thông tin hiển thị</h2><div class="row g-3">
<div class="col-12"><label asp-for="Form.DisplayName" class="form-label">Tên hiển thị *</label><input asp-for="Form.DisplayName" class="form-control" required maxlength="150" /></div>
<div class="col-12">@if(!string.IsNullOrEmpty(Model.Form.CurrentAvatar)){<img src="@Model.Form.CurrentAvatar" width="80" height="80" class="tutor-avatar mb-2" alt="Ảnh đại diện hiện tại" />}<label asp-for="Form.Avatar" class="form-label d-block">Ảnh đại diện @(string.IsNullOrEmpty(Model.Form.CurrentAvatar)?"*":"")</label><input asp-for="Form.Avatar" type="file" accept="image/jpeg,image/png" class="form-control" required="@string.IsNullOrEmpty(Model.Form.CurrentAvatar)" /><p class="form-text">JPG hoặc PNG, tối đa 2 MB. Bỏ trống để giữ ảnh hiện tại.</p></div>
<div class="col-12"><label asp-for="Form.Introduction" class="form-label">Giới thiệu bản thân *</label><textarea asp-for="Form.Introduction" class="form-control" rows="4" required maxlength="4000"></textarea><p class="form-text">Không nhập email, số điện thoại hoặc địa chỉ chi tiết vào thông tin công khai.</p></div>
</div><h2 class="mt-4">Trình độ và chuyên môn</h2><div class="row g-3">
<div class="col-12"><label asp-for="Form.Qualification" class="form-label">Trình độ *</label><input asp-for="Form.Qualification" class="form-control" required maxlength="200" placeholder="Ví dụ: Sinh viên Sư phạm, Cử nhân…" /></div>
<div class="col-md-6"><label asp-for="Form.School" class="form-label">Trường đào tạo *</label><input asp-for="Form.School" class="form-control" required maxlength="200" /></div>
<div class="col-md-6"><label asp-for="Form.Major" class="form-label">Chuyên ngành *</label><input asp-for="Form.Major" class="form-control" required maxlength="200" /></div>
<div class="col-12"><label asp-for="Form.StudyStatus" class="form-label">Tình trạng học tập *</label><select asp-for="Form.StudyStatus" class="form-select"><option value="DangHoc">Đang học</option><option value="DaTotNghiep">Đã tốt nghiệp</option></select></div>
<div class="col-12"><label asp-for="Form.Expertise" class="form-label">Thế mạnh chuyên môn *</label><input asp-for="Form.Expertise" class="form-control" required maxlength="500" /></div>
<div class="col-12"><label asp-for="Form.Experience" class="form-label">Kinh nghiệm giảng dạy *</label><textarea asp-for="Form.Experience" class="form-control" required maxlength="2000" rows="3"></textarea></div>
<div class="col-12"><fieldset><legend class="fs-6">Môn dạy *</legend><div class="d-flex gap-3 flex-wrap">@foreach(var s in Model.Workspace.Subjects){<label><input type="checkbox" name="Form.Subjects" value="@s.Id" checked="@Model.Form.Subjects.Contains(s.Id)" class="form-check-input" /> @s.TenMon</label>}</div></fieldset></div>
<div class="col-12"><label asp-for="Form.TeachingScope" class="form-label">Khối lớp và phạm vi dạy *</label><input asp-for="Form.TeachingScope" class="form-control" required maxlength="500" placeholder="Ví dụ: Lớp 6, Lớp 7, Lớp 8, Lớp 9" /><p class="form-text">Liệt kê khối lớp cách nhau bằng dấu phẩy để người học lọc đúng khối.</p></div>
</div></section></div><aside class="col-lg-4"><section class="surface editor-summary"><h2>Gửi quản trị viên duyệt</h2><p>Tên, ảnh, trình độ, chuyên môn, môn dạy và minh chứng cần được xét duyệt.</p><p>Học phí, hình thức dạy, khu vực và lịch rảnh nằm ở phần điều kiện nhận lớp; thay đổi có hiệu lực ngay.</p><button class="btn btn-pink w-100" type="submit" disabled="@(Model.Workspace.Subjects.Count==0)">Gửi hồ sơ xét duyệt</button><a class="btn btn-link w-100 mt-2" asp-action="ChiTiet">Quay lại hồ sơ</a></section></aside></div></form>
@if(Model.Workspace.MyProfile!=null){<div class="mt-4">@await Component.InvokeAsync("ProfileExtras")</div>}
