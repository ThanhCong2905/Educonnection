@model KetNoiGiaSu.ViewModels.MyAccountViewModel
@{ Layout = "_WorkspaceLayout"; }
@{ ViewData["Title"] = "Hồ sơ cá nhân"; }
@await Component.InvokeAsync("ProfileExtras")
<div class="page-heading"><div><p class="overline">THÔNG TIN CỦA BẠN</p><h1>Hồ sơ cá nhân</h1><p>Thông tin tài khoản chỉ hiển thị cho chính bạn.</p></div></div><div class="row g-4"><div class="col-lg-8"><section class="surface profile-section"><div class="card-person mb-4"><span class="profile-avatar">@Model.Name.Split(' ',StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?[..1]</span><div><h2>@Model.Name</h2><span class="tag">@(Model.Workspace.IsParent ? "Phụ huynh" : "Học sinh")</span></div></div><dl class="account-info"><dt>Email</dt><dd>@Model.Email</dd><dt>Số điện thoại</dt><dd>@Model.Phone</dd></dl><a class="btn btn-outline-pink" asp-controller="TaiKhoan" asp-action="DoiMatKhau">Đổi mật khẩu</a></section></div><aside class="col-lg-4"><div class="surface profile-section"><h2>@(Model.Workspace.IsParent ? "Bạn đại diện cho người học" : "Chủ động với mục tiêu học tập")</h2><p>@(Model.Workspace.IsParent ? "Khai thông tin người được học trong từng nhu cầu. Tài khoản phụ huynh và học sinh hoạt động độc lập." : "Tạo nhu cầu học để chia sẻ mục tiêu, khối lớp và lịch rảnh của bạn.")</p><a class="btn btn-pink" asp-controller="NhuCau" asp-action="Index">Nhu cầu học của tôi</a></div></aside></div>
