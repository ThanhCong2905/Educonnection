@model KetNoiGiaSu.ViewModels.ProfileEditorViewModel
@{ ViewData["Title"] = "Hoàn thiện hồ sơ gia sư"; }
@await Component.InvokeAsync("ProfileExtras")
<div class="breadcrumbs"><a asp-action="Profile">Hồ sơ của tôi</a><span>/</span>Chỉnh sửa</div><div class="page-heading"><div><p class="overline">GIỚI THIỆU CHÍNH BẠN</p><h1>Hoàn thiện hồ sơ gia sư</h1><p>Thông tin sẽ được quản trị viên xem xét trước khi bạn tham gia nhận lớp.</p></div></div>
<form asp-action="EditProfile" method="post" data-workspace-form><input asp-for="Form.Version" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><div class="row g-4"><div class="col-lg-8"><section class="surface editor-section"><h2>Thông tin chuyên môn</h2><div class="row g-3">
<div class="col-12"><label asp-for="Form.Qualification" class="form-label">Trình độ <span class="required">*</span></label><input asp-for="Form.Qualification" required maxlength="200" class="form-control" placeholder="Ví dụ: Cử nhân Sư phạm Toán học" /></div>
<div class="col-12"><label asp-for="Form.Expertise" class="form-label">Chuyên môn <span class="required">*</span></label><input asp-for="Form.Expertise" required maxlength="500" class="form-control" placeholder="Lĩnh vực và thế mạnh giảng dạy" /></div>
<div class="col-12"><label asp-for="Form.Experience" class="form-label">Kinh nghiệm <span class="required">*</span></label><textarea asp-for="Form.Experience" required maxlength="2000" class="form-control" rows="3"></textarea></div>
<div class="col-12"><label asp-for="Form.Introduction" class="form-label">Giới thiệu bản thân <span class="required">*</span></label><textarea asp-for="Form.Introduction" required maxlength="4000" class="form-control" rows="5"></textarea><p class="form-text">Không công khai số điện thoại, email hay giấy tờ định danh trong mô tả.</p></div>
<div class="col-12"><fieldset><legend class="form-label fs-6">Môn nhận dạy <span class="required">*</span></legend><div class="d-flex gap-3 flex-wrap">@foreach(var s in Model.Workspace.Subjects){<label class="form-check"><input class="form-check-input" type="checkbox" name="Form.Subjects" value="@s.Id" checked="@Model.Form.Subjects.Contains(s.Id)" />@s.TenMon</label>}</div></fieldset>@if(Model.Workspace.Subjects.Count==0){<p class="text-muted">Danh mục môn học chưa có dữ liệu. Vui lòng liên hệ quản trị viên.</p>}</div>
<div class="col-12"><label asp-for="Form.TeachingScope" class="form-label">Phạm vi nhận dạy <span class="required">*</span></label><input asp-for="Form.TeachingScope" class="form-control" maxlength="500" required placeholder="Ví dụ: Toán THCS, ôn thi vào lớp 10" /></div>
<div class="col-12"><label asp-for="Form.Region" class="form-label">Khu vực nhận dạy <span class="required">*</span></label><input asp-for="Form.Region" required maxlength="200" class="form-control" placeholder="Ví dụ: Hà Nội; trực tuyến toàn quốc" /></div>
<div class="col-sm-6"><label asp-for="Form.Fee" class="form-label">Học phí công khai (đ)</label><input asp-for="Form.Fee" required type="number" min="0" max="100000000" step="1000" class="form-control" /></div><div class="col-sm-6"><label asp-for="Form.FeeUnit" class="form-label">Đơn vị học phí</label><select asp-for="Form.FeeUnit" class="form-select"><option value="0">Mỗi giờ</option><option value="1">Mỗi buổi</option><option value="2">Mỗi tháng</option></select></div>
</div></section></div><aside class="col-lg-4"><div class="surface editor-summary"><span class="feature-icon"><img src="~/images/ui/shield-check.svg" width="26" height="26" alt="" /></span><h2>Hồ sơ cần được xét duyệt</h2><p>Chỉ khi hồ sơ được duyệt, bạn mới được tạo nhu cầu nhận lớp, kết nối và nhắn tin.</p><p class="small text-muted">Mỗi lần gửi thay đổi, hồ sơ sẽ chuyển về chờ xét duyệt. Nhu cầu nhận lớp sẽ không được công khai khi hồ sơ chưa được duyệt.</p><button class="btn btn-pink w-100" type="submit" disabled="@(Model.Workspace.Subjects.Count==0)">Lưu thông tin chuyên môn</button><a class="btn btn-link w-100 mt-2" asp-action="Profile">Quay lại hồ sơ</a></div></aside></div></form>
