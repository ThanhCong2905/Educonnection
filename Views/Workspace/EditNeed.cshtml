@model KetNoiGiaSu.ViewModels.NeedEditorViewModel
@{ ViewData["Title"] = Model.Form.Id.HasValue ? "Chỉnh sửa nhu cầu" : "Tạo nhu cầu mới"; var tutor = Model.Workspace.IsTutor; }
<div class="breadcrumbs"><a asp-action="Needs">@(tutor ? "Nhu cầu dạy" : "Nhu cầu học")</a><span>/</span>@ViewData["Title"]</div>
<div class="page-heading"><div><p class="overline">CHIA SẺ ĐỂ KẾT NỐI TỐT HƠN</p><h1>@ViewData["Title"]</h1><p>@(tutor ? "Cho học sinh biết chuyên môn và điều kiện nhận lớp của bạn." : "Cung cấp thông tin để gia sư hiểu đúng mục tiêu của bạn.")</p></div></div>
<form asp-action="EditNeed" method="post" class="need-editor" data-workspace-form>
    <input asp-for="Form.Id" type="hidden" /><input asp-for="Form.Version" type="hidden" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    @if(Model.Workspace.Subjects.Count == 0) { <div class="alert alert-warning">Danh mục môn học hiện chưa có dữ liệu. Vui lòng liên hệ quản trị viên trước khi tạo nhu cầu.</div> }
    <div class="row g-4"><div class="col-lg-8">
        <section class="surface editor-section"><div class="section-number">01</div><h2>Thông tin @(tutor ? "nhận lớp" : "học tập")</h2><div class="row g-3">
            <div class="col-sm-6"><label asp-for="Form.SubjectId" class="form-label">Môn học <span class="required">*</span></label><select asp-for="Form.SubjectId" class="form-select" required><option value="">Chọn môn học</option>@foreach(var s in Model.Workspace.Subjects) { <option value="@s.Id">@s.TenMon</option> }</select></div>
            <div class="col-sm-6"><label asp-for="Form.Grade" class="form-label">@(tutor ? "Khối lớp nhận dạy" : "Khối lớp") <span class="required">*</span></label><select asp-for="Form.Grade" class="form-select" required><option value="">Chọn khối lớp</option>@for(var g=1;g<=12;g++){<option>Lớp @g</option>}<option>Ngoại ngữ</option><option>Đại học</option></select></div>
            <div class="col-12"><label asp-for="Form.Goal" class="form-label">@(tutor ? "Đối tượng & mục tiêu nhận dạy" : "Mục tiêu học tập") <span class="required">*</span></label><textarea asp-for="Form.Goal" class="form-control" rows="4" maxlength="2000" required placeholder="Ví dụ: Củng cố kiến thức Toán lớp 9, chuẩn bị thi vào lớp 10…"></textarea><p class="form-text">Không đưa số điện thoại, địa chỉ chi tiết hoặc thông tin riêng tư vào mô tả công khai.</p></div>
            @if (Model.Workspace.IsParent)
            { <div class="col-12"><div class="private-note">Thông tin dưới đây dùng xác định người được học; không hiển thị trên thẻ tìm kiếm.</div></div><div class="col-sm-8"><label asp-for="Form.LearnerName" class="form-label">Họ tên người học <span class="required">*</span></label><input asp-for="Form.LearnerName" class="form-control" maxlength="150" required /></div><div class="col-sm-4"><label asp-for="Form.LearnerAge" class="form-label">Tuổi người học</label><input asp-for="Form.LearnerAge" type="number" min="1" max="100" class="form-control" /></div> }
        </div></section>
        <section class="surface editor-section"><div class="section-number">02</div><h2>Hình thức & học phí</h2><p class="form-text">Địa điểm điền từ <a asp-controller="ProfileData" asp-action="Address">hồ sơ cá nhân</a> khi tạo mới. Chỉ khu vực chung hiển thị công khai.</p><div class="row g-3">
            <div class="col-sm-6"><label asp-for="Form.Format" class="form-label">Hình thức học</label><select asp-for="Form.Format" class="form-select" id="need-format"><option value="0">Trực tuyến</option><option value="1">Trực tiếp</option></select></div>
            <div class="col-sm-6"><label asp-for="Form.Region" class="form-label">Khu vực học trực tiếp</label><input asp-for="Form.Region" maxlength="200" class="form-control" placeholder="Ví dụ: Cầu Giấy, Hà Nội" id="need-region" /></div>
            <div class="col-12" id="need-address-group"><label asp-for="Form.DetailedAddress" class="form-label">Địa chỉ chi tiết (riêng tư)</label><textarea asp-for="Form.DetailedAddress" class="form-control" maxlength="500" rows="2" id="need-address"></textarea><p class="form-text">Không hiển thị trên bài đăng, hồ sơ công khai, tìm kiếm hoặc so sánh.</p></div>
            <div class="col-sm-6"><label asp-for="Form.Fee" class="form-label">@(tutor ? "Học phí mong muốn" : "Ngân sách dự kiến") (đ) <span class="required">*</span></label><input asp-for="Form.Fee" type="number" min="0" max="100000000" step="1000" class="form-control" required /></div>
            <div class="col-sm-6"><label asp-for="Form.FeeUnit" class="form-label">Đơn vị</label><select asp-for="Form.FeeUnit" class="form-select"><option value="0">Mỗi giờ</option><option value="1">Mỗi buổi</option><option value="2">Mỗi tháng</option></select></div>
        </div></section>
        <section class="surface editor-section"><div class="section-number">03</div><h2>Thời gian có thể @(tutor ? "dạy" : "học")</h2><p class="text-muted small">Chọn các ngày có cùng khung giờ rảnh. Đây là thời gian dự kiến, chưa phải lịch lớp học.</p><div class="day-picker">@foreach (var day in new[] { (1,"T2"),(2,"T3"),(3,"T4"),(4,"T5"),(5,"T6"),(6,"T7"),(0,"CN") }) { <label><input type="checkbox" name="Form.Days" value="@day.Item1" checked="@Model.Form.Days.Contains(day.Item1)" /><span>@day.Item2</span></label> }</div><div class="row g-3 mt-1"><div class="col-sm-4"><label asp-for="Form.Start" class="form-label">Từ giờ</label><input asp-for="Form.Start" type="time" class="form-control" /></div><div class="col-sm-4"><label asp-for="Form.End" class="form-label">Đến giờ</label><input asp-for="Form.End" type="time" class="form-control" /></div><div class="col-sm-4"><label asp-for="Form.WeeklySessions" class="form-label">Số buổi / tuần</label><input asp-for="Form.WeeklySessions" type="number" min="1" max="7" class="form-control" required /></div></div>@if(Model.Form.Id.HasValue){<p class="form-text mt-3">Lưu thay đổi sẽ thay thế lịch rảnh cũ bằng các ngày và khung giờ đang chọn.</p>}</section>
    </div><aside class="col-lg-4"><div class="surface editor-summary"><span class="feature-icon"><img src="~/images/ui/lightbulb.svg" width="24" height="24" alt="" /></span><h2>Một nhu cầu tốt cần gì?</h2><ul><li>Môn và khối lớp cụ thể.</li><li>Mục tiêu có thể trao đổi rõ ràng.</li><li>Khung giờ và học phí thực tế.</li></ul><hr /><p class="small text-muted">Lưu nháp để hoàn thiện sau. Khi mở nhu cầu, thông tin công khai có thể xuất hiện trong tìm kiếm.</p><button class="btn btn-pink w-100 mb-2" type="submit" name="Form.Publish" value="true" disabled="@(Model.Workspace.Subjects.Count == 0)">Mở nhu cầu</button><button class="btn btn-outline-pink w-100" type="submit" name="Form.Publish" value="false" disabled="@(Model.Workspace.Subjects.Count == 0)">Lưu bản nháp</button><a class="btn btn-link w-100 mt-2" asp-action="Needs">Quay lại danh sách</a></div></aside></div>
</form>
