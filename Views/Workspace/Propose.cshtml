@model KetNoiGiaSu.ViewModels.ProposalViewModel
@{ ViewData["Title"]="Đề xuất lớp học"; }
<div class="page-heading"><div><p class="overline">THỐNG NHẤT TRƯỚC KHI BẮT ĐẦU</p><h1>Đề xuất lớp học</h1><p>Bên học cần xác nhận các điều kiện dưới đây trước khi hệ thống tạo lớp.</p></div></div>
<form asp-action="Propose" method="post" class="surface editor-section" data-workspace-form><input asp-for="Form.Id" type="hidden" /><input asp-for="Form.Version" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><div class="row g-3">
<div class="col-md-8"><label asp-for="Form.Name" class="form-label">Tên lớp *</label><input asp-for="Form.Name" class="form-control" required maxlength="200" /></div><div class="col-md-4"><label asp-for="Form.SubjectId" class="form-label">Môn học *</label><select asp-for="Form.SubjectId" class="form-select" required><option value="">Chọn môn</option>@foreach(var s in Model.Workspace.Subjects){<option value="@s.Id">@s.TenMon</option>}</select></div>
<div class="col-12"><label asp-for="Form.Goal" class="form-label">Mục tiêu *</label><textarea asp-for="Form.Goal" class="form-control" required maxlength="2000"></textarea></div>
<div class="col-md-6"><label asp-for="Form.Sessions" class="form-label">Số buổi / tuần *</label><input asp-for="Form.Sessions" class="form-control" type="number" min="1" max="7" required /></div><div class="col-md-6"><label asp-for="Form.Duration" class="form-label">Phút / buổi *</label><input asp-for="Form.Duration" class="form-control" type="number" min="1" max="480" required /></div>
<div class="col-12"><label asp-for="Form.Schedule" class="form-label">Lịch học dự kiến *</label><textarea asp-for="Form.Schedule" class="form-control" required maxlength="2000" placeholder="Ghi rõ ngày bắt đầu, ngày học và giờ học đã trao đổi."></textarea></div>
<div class="col-md-6"><label asp-for="Form.Format" class="form-label">Hình thức</label><select asp-for="Form.Format" class="form-select"><option value="0">Trực tuyến</option><option value="1">Trực tiếp</option></select></div><div class="col-md-6"><label asp-for="Form.Location" class="form-label">Địa điểm (bắt buộc nếu trực tiếp)</label><input asp-for="Form.Location" class="form-control" maxlength="500" /><p class="form-text">Chỉ hai bên kết nối được xem địa điểm này.</p></div>
<div class="col-md-6"><label asp-for="Form.Fee" class="form-label">Học phí (đ) *</label><input asp-for="Form.Fee" class="form-control" type="number" min="0" max="100000000" required /></div><div class="col-md-6"><label asp-for="Form.FeeUnit" class="form-label">Đơn vị</label><select asp-for="Form.FeeUnit" class="form-select"><option value="0">Mỗi giờ</option><option value="1">Mỗi buổi</option><option value="2">Mỗi tháng</option></select></div>
</div><div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-pink" type="submit">Gửi đề xuất lớp</button><a class="btn btn-light" asp-action="Connections">Quay lại</a></div></form>
