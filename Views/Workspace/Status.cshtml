@model KetNoiGiaSu.ViewModels.WorkspaceViewModel
@{ ViewData["Title"] = "Trạng thái xử lý"; }
<div class="page-heading"><div><p class="overline">THEO DÕI CỦA BẠN</p><h1>Trạng thái xử lý</h1><p>Theo dõi các yêu cầu xét duyệt và kết quả xử lý liên quan đến tài khoản.</p></div></div>
@if(Model.IsTutor){<section class="surface profile-section mb-4"><h2>Hồ sơ gia sư</h2><span class="tag @(Model.CanPublish ? "approved" : "")">@(Model.MyProfile == null ? "Chưa tạo hồ sơ" : Model.MyProfile.TrangThaiDuyet == KetNoiGiaSu.Models.ProfileReviewState.Approved ? "Đã duyệt" : Model.MyProfile.TrangThaiDuyet == KetNoiGiaSu.Models.ProfileReviewState.Pending ? "Chờ xét duyệt" : "Bị từ chối")</span>@if(!string.IsNullOrEmpty(Model.MyProfile?.LyDoTuChoi)){<p class="mt-3">Lý do: @Model.MyProfile.LyDoTuChoi</p>}<p class="mt-3"><a asp-controller="HoSoGiaSu" asp-action="ChiTiet">Xem hồ sơ</a></p></section>}
<section class="surface profile-section"><h2>Báo cáo vi phạm · Sắp có</h2><p class="text-muted mb-0">Bạn sẽ có thể theo dõi báo cáo đã gửi và các kết quả xử lý liên quan đến tài khoản tại đây.</p></section>
