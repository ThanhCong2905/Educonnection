@model KetNoiGiaSu.ViewModels.NeedCard
@{ ViewData["Title"]="Chi tiết nhu cầu học"; var workspace=(KetNoiGiaSu.ViewModels.WorkspaceViewModel)ViewData["Workspace"]!; }
<div class="breadcrumbs"><a asp-controller="TimKiem" asp-action="Tim">Tìm nhu cầu học</a><span>/</span>Chi tiết nhu cầu</div>
<div class="row g-4"><div class="col-lg-8"><section class="surface profile-section"><div class="card-person mb-4"><span class="avatar avatar-learning">@Model.Initial</span><div><h1>@Model.OwnerName</h1><span class="small text-muted">Người đăng nhu cầu học</span></div></div><span class="tag approved">Nhu cầu đang mở</span><h2 class="mt-3">@Model.Subject · @Model.Grade</h2><p class="text-muted">@(Model.Format==0?"Trực tuyến":Model.Region) · @Model.WeeklySessions buổi / tuần</p><h2 class="mt-4">Mục tiêu học tập</h2><p class="preserve-lines">@Model.Goal</p><h2 class="mt-4">Khung giờ rảnh</h2>
@if(Model.Slots.Count==0){<p>Chưa có khung giờ được công bố.</p>}else{<div class="d-flex flex-wrap gap-2">@foreach(var slot in Model.Slots){<span class="tag">@(slot.ThuTrongTuan==0?"Chủ nhật":"Thứ "+(slot.ThuTrongTuan+1)) · @slot.GioBatDau.ToString("HH:mm")–@slot.GioKetThuc.ToString("HH:mm")</span>}</div>}
<h2 class="mt-4">Ngân sách dự kiến</h2><p class="profile-price">@(Model.Fee?.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))??"Thỏa thuận")đ <small>/ @(Model.FeeUnit==0?"giờ":Model.FeeUnit==1?"buổi":"tháng")</small></p><p class="private-note">Tên, tuổi và địa chỉ chi tiết của người học không được công khai.</p></section></div>
<aside class="col-lg-4"><section class="surface contact-panel"><h2>Liên hệ với người đăng</h2><partial name="_ContactPanel" model="@(new KetNoiGiaSu.ViewModels.ContactPanelViewModel {Owner=workspace.UserId,Target=Model.OwnerId,NeedId=Model.Id,Contact=Model.Contact,CanInteract=workspace.CanPublish})" /></section></aside></div>
