@model KetNoiGiaSu.ViewModels.MessagesViewModel
@{ ViewData["Title"]="Tin nhắn"; }
<div class="page-heading"><div><p class="overline">TRAO ĐỔI ĐỂ HIỂU NHAU HƠN</p><h1>Tin nhắn</h1><p>Cuộc trò chuyện riêng giữa gia sư và bên học.</p></div></div>
<div class="messaging-layout">
<aside class="surface conversation-list"><h2>Cuộc trò chuyện</h2>@if(Model.Conversations.Count==0){<p class="text-muted">Chưa có cuộc trò chuyện. Gửi yêu cầu liên hệ và chờ người nhận chấp nhận để bắt đầu.</p>}
@foreach(var c in Model.Conversations){<a class="conversation-link @(Model.Selected==c.Id?"active":"")" asp-controller="TinNhan" asp-action="DanhSachHoiThoai" asp-route-id="@c.Id"><strong>@c.Name</strong><span>@(c.LastMessage??"Bắt đầu trao đổi")</span></a>}</aside>
<section class="surface chat-panel" data-chat-panel data-feed="@Url.Action("LayDanhSach", "TinNhan", new{id=Model.Selected})" data-page="@Model.Page" data-selected="@Model.Selected">
@if(!Model.Selected.HasValue){<div class="empty-state"><h2>Chọn cuộc trò chuyện</h2><p>Thống nhất mục tiêu, lịch học và học phí trước khi kết nối.</p></div>}
else {
<header class="chat-header"><h2>@Model.Name</h2><a asp-controller="KetNoi" asp-action="DanhSach">Kết nối</a></header>
<div class="chat-history-nav">@if(Model.Messages.Count==100){<a asp-controller="TinNhan" asp-action="DanhSachHoiThoai" asp-route-id="@Model.Selected" asp-route-page="@(Model.Page+1)">Xem tin cũ hơn</a>}@if(Model.Page>1){<a asp-controller="TinNhan" asp-action="DanhSachHoiThoai" asp-route-id="@Model.Selected">Về tin mới nhất</a>}</div>
<div class="chat-stream" id="chat-stream" role="log" aria-label="Lịch sử trò chuyện" aria-live="polite">
@foreach(var m in Model.Messages){<article class="chat-message @(m.NguoiGuiId==Model.Owner?"mine":"")" data-message-id="@m.Id"><p>@m.NoiDung</p><time datetime="@m.GuiLuc.ToString("O")">@m.GuiLuc.ToLocalTime().ToString("dd/MM HH:mm")</time></article>}
</div>
<p id="chat-feedback" class="chat-feedback" role="status"></p>
<form asp-controller="TinNhan" asp-action="Gui" method="post" id="chat-form" class="chat-compose"><input type="hidden" name="ConversationId" value="@Model.Selected" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><label for="chat-text" class="visually-hidden">Nội dung tin nhắn</label><textarea id="chat-text" name="Text" rows="2" class="form-control" required maxlength="4000" placeholder="Nhập tin nhắn…" aria-describedby="chat-keyboard-help"></textarea><button class="btn btn-pink" type="submit">Gửi</button></form>
}
<p id="chat-keyboard-help" class="small text-muted mt-2">Enter để gửi · Shift+Enter để xuống dòng</p></section></div>
@section Scripts {<script src="~/js/messages.js" asp-append-version="true" defer></script>}
