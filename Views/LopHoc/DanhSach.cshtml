@model KetNoiGiaSu.ViewModels.ClassesViewModel
@{ViewData["Title"]="Lớp học";}
<div class="page-heading"><div><p class="overline">HỌC TẬP CÙNG NHAU</p><h1>Lớp học của bạn</h1><p>Các lớp đã được hai bên xác nhận từ đề xuất kết nối.</p></div></div>
@if(Model.Classes.Count==0){<section class="empty-state surface"><h2>Chưa có lớp học</h2><p>Xác nhận đề xuất của gia sư để bắt đầu.</p><a class="btn btn-pink" asp-controller="KetNoi" asp-action="DanhSach">Xem kết nối</a></section>}
<div class="row g-4">@foreach(var c in Model.Classes){<div class="col-lg-6"><article class="surface profile-section"><span class="tag approved">Đã xác nhận</span><h2 class="mt-3">@c.TenLop</h2><p class="preserve-lines">@c.MucTieu</p><p>@c.SoBuoiTuan buổi / tuần · @c.ThoiLuongPhut phút / buổi</p><p>@(c.HinhThucHoc==0?"Trực tuyến":c.DiaDiem)</p><p class="profile-price">@c.HocPhi.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))đ <small>/ @(c.DonViHocPhi==0?"giờ":c.DonViHocPhi==1?"buổi":"tháng")</small></p><form asp-controller="TinNhan" asp-action="MoHoiThoai" method="post"><input type="hidden" name="target" value="@(Model.Workspace.IsTutor?c.BenHocId:c.GiaSuId)" /><button class="btn btn-outline-pink">Nhắn tin</button></form></article></div>}</div>
