@model KetNoiGiaSu.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<section class="auth-card"><h1>Đặt lại mật khẩu</h1><p class="subtitle">Tạo mật khẩu mới để bảo vệ tài khoản của bạn.</p>
    <form asp-action="ResetPassword" method="post" data-auth-form>
        <input asp-for="Code" type="hidden" /><input asp-for="Email" type="hidden" />
        <div asp-validation-summary="All" class="notice error" role="alert"></div>
        <partial name="_NewPasswordFields" />
        <button class="primary-button" type="submit" data-idle="Lưu mật khẩu mới" data-busy="Đang lưu…">Lưu mật khẩu mới</button>
        <p class="switch-form"><a asp-action="Login">Quay lại đăng nhập</a></p>
    </form>
</section>
